<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面统计卡片（4x2）：品牌青渐变 + 三格数字统计 + 三按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <!-- 顶部：标题 + 点位 / 右侧实时胶囊 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JSNU 洗衣雷达"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_point"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="当前点位"
                android:textColor="#D6FFF7"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_chip_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="● 实时"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 三格统计：大数字 + 标签横排 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_idle_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="空闲"
                android:textColor="#D6FFF7"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_res_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#CFE9FF"
                android:textStyle="bold"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="可约"
                android:textColor="#D6FFF7"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_fault_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFE0DE"
                android:textStyle="bold"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="故障"
                android:textColor="#D6FFF7"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 快捷按钮：刷新 / 蹲守 / 去海乐 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_refresh"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="34dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_bg"
            android:text="↻ 刷新"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/widget_btn_watch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_bg"
            android:text="◉ 蹲守"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/widget_btn_haier"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_btn_bg"
            android:text="去海乐"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>
</LinearLayout>
