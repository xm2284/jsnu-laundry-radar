<?xml version="1.0" encoding="utf-8"?>
<!-- 洗衣中追踪卡片：显示被标记机器的实时倒计时、预计洗完时间，带定闹钟/去海乐/取消按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tracking_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- 顶部：标题 + 点位 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ 洗衣中追踪"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_tracking_point"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="当前点位"
            android:textColor="#D6FFF7"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="end" />
    </LinearLayout>

    <!-- 追踪内容（有追踪机器时显示） -->
    <LinearLayout
        android:id="@+id/widget_tracking_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:id="@+id/widget_tracking_machine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="18#4楼1号机"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <Chronometer
            android:id="@+id/widget_tracking_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="还剩 00:00"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:gravity="center"
            android:format="还剩 %s" />

        <TextView
            android:id="@+id/widget_tracking_finish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="预计 14:30 洗完"
            android:textColor="#D6FFF7"
            android:textSize="10sp"
            android:gravity="center"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 空状态（无追踪机器时显示） -->
    <TextView
        android:id="@+id/widget_tracking_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无洗衣中追踪\n在首页标记已用的机器会显示在这里"
        android:textColor="#D6FFF7"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone" />

    <!-- 底部按钮：定闹钟 / 去海乐 / 取消追踪 -->
    <LinearLayout
        android:id="@+id/widget_tracking_btn_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_tracking_btn_alarm"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:text="⏰ 定闹钟"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/widget_tracking_btn_haier"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:text="去海乐"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/widget_tracking_btn_cancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:text="取消追踪"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>
</LinearLayout>
