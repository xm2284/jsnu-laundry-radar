<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 桌面快捷方式/小组件：部分国产 ROM（OPPO/ColorOS、小米）需此权限才能在桌面添加卡片 -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!-- Android 11+（API30+）包可见性：不声明则 getLaunchIntentForPackage/getPackageInfo 对其他 App 返回空，
         会误判海乐/QQ「未安装」而跳应用商店 -->
    <queries>
        <package android:name="com.yunshang.haile_life" />
        <package android:name="com.yunshang.haileshenghuo" />
        <package android:name="com.yunshang.campuswashingbusiness" />
        <package android:name="com.tencent.mobileqq" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:name=".LaundryApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.JSNULaundry"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.JSNULaundry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".watch.WatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".widget.WidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jsnu.laundry.action.REFRESH_WIDGET" />
                <action android:name="com.jsnu.laundry.action.TOGGLE_WATCH" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".watch.WatchActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jsnu.laundry.action.WATCH_NOTIFY_ALARM" />
                <action android:name="com.jsnu.laundry.action.WATCH_NOTIFY_HAIER" />
                <action android:name="com.jsnu.laundry.action.WATCH_NOTIFY_COPY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.LaundryAppWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/laundry_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TrackingAppWidgetProvider"
            android:exported="true"
            android:label="@string/widget_tracking_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/laundry_widget_tracking_info" />
        </receiver>

    </application>

</manifest>
